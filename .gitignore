# --- iOS (CocoaPods) ---
# O Podfile.lock DEVE ser versionado para garantir que todos tenham a mesma versão das libs.
# Mas a pasta Pods/ é gerada, então ignoramos ela.
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework/
ios/Flutter/App.framework/
# Ignora arquivos de configurações de usuário do Xcode
*.xcuserdata
*.xcuserdatad

